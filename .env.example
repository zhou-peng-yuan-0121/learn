# agentlab 配置模板 —— 复制成 .env 后填写你自己的值
#
#   cp .env.example .env      (Windows: copy .env.example .env)
#
# .env 已在 .gitignore 里，不会被提交，把 key 写在这里是安全的。

# ---------- 对话模型（OpenAI 兼容接口） ----------
AGENTLAB_BASE_URL=https://api.deepseek.com/v1
AGENTLAB_API_KEY=
AGENTLAB_MODEL=deepseek-chat

# ---------- 嵌入模型（可选） ----------
# 留空 = 用内置的离线 HashingEmbedder：不用 key、不联网、可复现，
#        但只懂字面相似（同义词认不出来）。
# 填写 = 走 <base_url>/embeddings，语义效果更好。
#        注意 DeepSeek 目前没有 embeddings 接口，需要把 BASE_URL 指向
#        支持该接口的服务（OpenAI / 智谱 / 硅基流动 / 本地 vLLM 等）。
AGENTLAB_EMBED_MODEL=

# ---------- 本地服务 ----------
AGENTLAB_HOST=127.0.0.1
AGENTLAB_PORT=7860

# ---------- 数据与日志 ----------
# 数据库文件会放在这个目录下的 knowledge.db
AGENTLAB_DATA_DIR=
AGENTLAB_LOG_LEVEL=INFO
